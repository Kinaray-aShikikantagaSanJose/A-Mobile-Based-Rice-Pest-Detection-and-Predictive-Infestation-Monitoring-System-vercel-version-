<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before Flutter draws its first frame (Android 11 and below):
     brand green with the logo centred, matching the welcome screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_green" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
