# Environment variables for the Palay Patrol API.
# On Vercel: add these in Project > Settings > Environment Variables.
# Locally: copy this file to .env and fill in real values. Never commit .env.

# ---- Supabase database -------------------------------------------------------
# Vercel: Supabase > Connect > Shared Pooler > Transaction (port 6543).
# Percent-encode special characters in the database password before inserting it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# For local development, DATABASE_URL may instead use a direct PostgreSQL URL,
# e.g. postgresql://postgres:<password>@localhost:5432/postgres.
# Leave empty: accounts and observations now share one Supabase database.
# GEO_DATABASE_URL=

# ---- Supabase Storage (observation photos and profile pictures) ---------------
# Supabase > Project Settings > API Keys: Project URL and a Secret API key
# (starts with sb_secret_). Keep it server-side only; it is sent in apikey only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback for existing deployments; omit when SUPABASE_SECRET_KEY is set.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Authentication ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Transport / CORS --------------------------------------------------------
# Vercel always serves HTTPS, so production mode is safe there.
APP_ENV=production
HTTPS_ONLY=true
# Comma-separated origins allowed to call the API from a browser:
# the deployed web dashboard and the mobile web app.
CORS_ALLOWED_ORIGINS=https://<your-dashboard>.vercel.app,https://<your-mobile-app>.vercel.app
# Optional, e.g. to allow preview deployments of those two projects:
# CORS_ALLOWED_ORIGIN_REGEX=https://(your-dashboard|your-mobile-app)-[a-z0-9-]+\.vercel\.app

# ---- Email (OTP codes, account approval notices) - Gmail App Password ---------
SMTP_USERNAME=your-project@gmail.com
SMTP_PASSWORD=your16charapppassword

# ---- Behaviour ----------------------------------------------------------------
# Require an agriculturist / OPA to approve new accounts before they can use
# the app. Off until an approving office account exists.
REQUIRE_ACCOUNT_APPROVAL=false
# Timezone for months, quarters, "today" and date filters (farmers' local time).
APP_TIMEZONE=Asia/Manila

# ---- Local development only (python run_server.py) ----------------------------
# Leave SUPABASE_URL empty to keep photos in uploads/ instead of Supabase Storage.
# For local HTTP set APP_ENV=development and HTTPS_ONLY=false.
# LAN discovery for the mobile app (ignored on Vercel):
# DISCOVERY_PORT=8001
# DISCOVERY_ENABLED=true
